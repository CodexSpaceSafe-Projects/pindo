{
  "name": "pindo-cloudflare-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:test": "esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=../../work/cloudflare-worker.mjs",
    "test": "npm run build:test && node --test test/*.test.mjs",
    "types": "cf workers types --mode development --include-runtime=false"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261114.1",
    "cf": "1.0.0-beta.32",
    "esbuild": "0.25.5",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3"
  }
}
